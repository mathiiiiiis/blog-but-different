# ==================================
# REQUIRED SETTINGS (Production)
# ==================================

# Database credentials
DB_USER=blog
DB_PASSWORD=your_secure_database_password_here
DB_NAME=blog

# MinIO/S3 credentials
MINIO_ROOT_USER=your_minio_user_here
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_BUCKET=blog

# Security - generate with: openssl rand -hex 32
# Must be at least 16 characters. The server refuses to start without it.
SECRET_KEY=your_secure_random_string_here

# Admin account (created on first run)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# For GIF support (required)
KLIPY_API_KEY=your_klipy_api_key_here

FCM_CREDENTIALS_PATH=/app/firebase-credentials.json

# ==================================
# OPTIONAL SETTINGS
# ==================================

# Port to expose the application (default: 80)
PORT=80

# CORS origins (comma separated). Set to your domain in production.
# A literal "*" allows nothing, because credentialed requests cannot use a
# wildcard. Leave empty if the frontend is served from the same origin.
CORS_ORIGINS=https://yourdomain.com

# Set false only if the backend is exposed directly, with no reverse proxy.
# When true, X-Forwarded-For is used for per-client rate limiting.
TRUST_PROXY=true

# Upload limits
MAX_FILE_SIZE=52428800
MAX_ATTACHMENTS=10
MAX_MESSAGE_LENGTH=10000

# Session lifetime in minutes (default: one year)
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# PGAdmin (database management UI at :5050)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_pgadmin_password_here
